      </link>
      
      <link name="wheel_left_link">
        <pose>0 0.095 0.033 -1.5707 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>1.1e-05</ixx><iyy>1.1e-05</iyy><izz>2.1e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
