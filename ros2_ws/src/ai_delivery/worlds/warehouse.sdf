        <sensor name="lidar" type="gpu_lidar">
          <pose>0.04 0 0.15 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan><horizontal><samples>240</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>6.257005</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
            <range><min>0.12</min><max>3.5</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </lidar>
          <visualize>true</visualize>
